# SharpSight Superset dev kit — copy to .env and fill in. .env is gitignored: no credential belongs in the repo.
#
#   cp .env.example .env
#   (then edit the four lines marked REQUIRED)

# Which of the kit's settings changes this file has been through. install.sh reads it on an upgrade and brings an
# older .env up to date ONCE (settings version 2: the chart cache finally applies, and is one hour; version 3:
# four workers where the machine has the room for them). Leave it.
DEVKIT_SETTINGS_VERSION=3

# REQUIRED — sign and encrypt this instance's sessions and its saved database passwords.
#   openssl rand -base64 42
DEVKIT_SECRET_KEY=

# REQUIRED — the password of the dev kit's own PostgreSQL (metadata + your extracts).
DEVKIT_DB_PASSWORD=

# REQUIRED — who signs in to Superset here.
DEVKIT_ADMIN_USER=admin
DEVKIT_ADMIN_PASSWORD=
DEVKIT_ADMIN_EMAIL=admin@sharpsight.local

# Where it listens. Loopback is the default on purpose; on a shared server set DEVKIT_BIND=0.0.0.0 AND put TLS
# in front of it (and then DEVKIT_BEHIND_PROXY=true, DEVKIT_COOKIE_SECURE=true).
DEVKIT_PORT=3002
DEVKIT_BIND=127.0.0.1
DEVKIT_BEHIND_PROXY=false
DEVKIT_COOKIE_SECURE=false

# Look and language
DEVKIT_APP_NAME=SharpSight Superset — atelier
DEVKIT_LOCALE=fr
DEVKIT_DARK=0

# Size. Four workers suit a server; two suit a laptop. Each worker that touches the CEM starts its own JVM, and
# with its pandas frames a worker takes about 500 MB: keep DEVKIT_MEMORY above workers × 600 MB. The threads are
# per worker, and the metadata pool follows them. CPUs and memory are LIMITS, not reservations.
DEVKIT_WORKERS=4
DEVKIT_THREADS=20
DEVKIT_CPUS=4.0
DEVKIT_MEMORY=4g
# The chart cache (Redis). A CEM chart's result can weigh megabytes; when the cache is full the oldest entries
# are thrown out and their dashboards ask the database again. The container's limit stays ~25 % above it.
DEVKIT_REDIS_MAXMEMORY=1gb
DEVKIT_REDIS_LIMIT=1280m
DEVKIT_DB_MEMORY=1g
# CPUs the kit's database may use. A dashboard tab sends its queries together: on one CPU, four of them took
# 1.1–1.6 s each where one alone takes 0.2 s (measured 2026-10-05). A limit, not a reservation.
DEVKIT_DB_CPUS=4.0

# How long a query may run — and, with it, how long gunicorn lets a request take before killing its worker.
# The image's own default is 60 s, which a slow cluster exceeds easily.
DEVKIT_SQLLAB_TIMEOUT=300

# How long a chart's result is kept, in seconds: one hour here; 21600 (six hours) suits a server whose sources
# load once a day. Editing a chart, a metric or a filter changes the query and so the cache entry — only new
# DATA behind the same query waits, and « Force refresh » asks again.
DEVKIT_DATA_CACHE_TTL=3600

# ── Scheduled refresh: dashboards open on cached data ────────────────────────────────────────────────────────────
# EACH DASHBOARD'S SCHEDULE IS SET IN SUPERSET: a tag on the dashboard (Edit properties → Tags) —
#   refresh:06:30 (every day at 06:30; one tag per time), refresh:30m, refresh:2h, refresh:off.
# These two lines are the DEFAULT, for a dashboard with no such tag: every N minutes, or at times of day
# (e.g. after the cluster's nightly load: DEVKIT_REFRESH_AT=06:30,13:00 — times in DEVKIT_TZ). Set
# DEVKIT_REFRESH_EVERY_MIN=0 and leave DEVKIT_REFRESH_AT empty to refresh only the dashboards you tagged.
# Between two refreshes the cached result is kept and the database is not asked.
DEVKIT_REFRESH_EVERY_MIN=60
DEVKIT_REFRESH_AT=
# a dashboard nobody opened for this many days stops being refreshed (a tagged one: the second number)
DEVKIT_REFRESH_KEEP_DAYS=7
DEVKIT_REFRESH_KEEP_DAYS_SCHEDULED=30
# how many queries it sends at once — the CEM cluster is shared: keep this low
DEVKIT_REFRESH_PARALLEL=2
DEVKIT_TZ=Africa/Casablanca

# A Superset worker is replaced after this many requests, so the memory it gathers over days is given back.
DEVKIT_WORKER_MAX_REQUESTS=10000

# ── Optional: HTTPS with HTTP/2 in front of Superset ──────────────────────────────────────────────────────────
# Uncomment COMPOSE_PROFILES and set DEVKIT_BEHIND_PROXY=true (above) to add https://localhost:3443 beside the
# plain port: a browser sends a dashboard's chart requests all at once over HTTP/2, six at a time without it.
# A self-signed certificate is made on first start; on a server, name the machine (DEVKIT_TLS_NAME) or point
# DEVKIT_TLS_DIR at a folder holding your own tls.crt and tls.key.
#COMPOSE_PROFILES=tls
DEVKIT_TLS_PORT=3443
#DEVKIT_TLS_NAME=devkit.example.internal
#DEVKIT_TLS_DIR=./certs

# Build without Java and the JDBC bridge (smaller image, no CEM helper): DEVKIT_WITH_JDBC=0
DEVKIT_WITH_JDBC=1

# ── The CEM, through its Yacht JDBC driver (cem_to_mart.py) ───────────────────────────────────────────────────
# Superset cannot dial this driver directly — there is no SQLAlchemy dialect for it — so a query is landed in
# the dev kit's own database and charted from there. Put the jar in ./driver-jars/ first.
# The shape the platform's own gateway uses (its JDBC_URL, host and port left to you):
#   jdbc:yacht://<host>:<port>/datacube_dc_run-SPARKSQL?timeout=3600
CEM_JDBC_URL=
# The driver class is NOT the one a search engine suggests: it is the class inside the Yacht jar, and the
# platform names it in DRIVER_CLASS. Written here so nobody has to guess it again.
CEM_JDBC_DRIVER=com.huawei.ryoma.yacht.client.YachtDriver
CEM_JDBC_JARS=/app/driver-jars/yacht-jdbc-25.70.278.jar
# The user and the password are passed as JDBC properties, not in the URL — most drivers ignore them there.
CEM_JDBC_USER=
CEM_JDBC_PASSWORD=
# A Kerberised cluster: put krb5.conf and the keytab in ./krb5/ (mounted read-only at /run/krb5) and set these.
CEM_KERBEROS=0
CEM_KRB_PRINCIPAL=
CEM_KRB_KEYTAB=/run/krb5/user.keytab
CEM_JVM_ARGS=

# ── SharpSight AI BI (optional — docs/ai-bi.md) ───────────────────────────────────────────────────────────────
# Leave these EMPTY: `bash ai-bi.sh` generates each one the first time it runs, and they are only needed when
# the engine is started. Hexadecimal only if you ever set one by hand — compose interpolates `$` in this file.
#   AIBI_API_TOKEN           what the portal (or the kit's own CLI) presents to the engine's API
#   AIBI_BUILDER_PASSWORD    bi_builder   — the dbt-runner: builds the governed models into schema `bi`
#   AIBI_DBT_DEV_PASSWORD    aibi_dbt_dev — the engine: builds what it generates into schema `bi_dev`, nowhere else
#   AIBI_READER_PASSWORD     bi_reader    — the data gateway and Superset's BI connection: reads, never writes
#   AIBI_RECORDS_READER_PASSWORD  bi_records_reader — reads the copy of the engine's own records, nothing else
#   AIBI_SUPERSET_GATEWAY_TOKEN   what Superset's extension presents to the engine: accepted for the projects, a
#                                 validation, a commit and a run — refused for everything else, approvals first
#   AIBI_SUPERSET_PASSWORD   the engine's own Superset account (sharpsight-ai)
AIBI_API_TOKEN=
AIBI_BUILDER_PASSWORD=
AIBI_DBT_DEV_PASSWORD=
AIBI_READER_PASSWORD=
AIBI_RECORDS_READER_PASSWORD=
AIBI_SUPERSET_GATEWAY_TOKEN=
AIBI_SUPERSET_PASSWORD=
# Where the engine's API listens (loopback only, always).
AIBI_PORT=3003
# Which model reads a request. `none` (the default) is the deterministic planner: it calls nobody, needs no
# key and no extra dependency — the kit runs offline exactly as before. A deployment that wants a model may
# set `claude` or `openai` instead (services/ai-bi/aibi/llm.py); the model only READS the request into the
# same governed requirement, and anything it names that the registry does not have is reported, not trusted.
#   claude  → `pip install anthropic`, key in AIBI_LLM_API_KEY or ANTHROPIC_API_KEY, model defaults to
#             claude-opus-5-5
#   openai  → `pip install openai`, key in AIBI_LLM_API_KEY or OPENAI_API_KEY, model named in AIBI_LLM_MODEL
# AIBI_LLM_BASE_URL points at an OpenAI-compatible or proxied endpoint, when you have one.
AIBI_LLM_PROVIDER=none
AIBI_LLM_MODEL=
AIBI_LLM_API_KEY=
AIBI_LLM_BASE_URL=

# ── Connections you add INSIDE Superset (Settings → Database Connections), not here ───────────────────────────
# SQL Server   mssql+pymssql://user:password@host:1433/database
# Oracle       oracle+cx_oracle://user:password@host:1521/?service_name=ORCLPDB1   (thin, no Instant Client)
# Oracle (SID) oracle+cx_oracle://user:password@host:1521/?sid=ORCL
# PostgreSQL   postgresql+psycopg2://user:password@host:5432/database
# Hive/Spark   hive://host:10000/default
# This kit's own store, for your extracts:
#              postgresql+psycopg2://devkit:<DEVKIT_DB_PASSWORD>@devkit-db:5432/devkit
