# The CEM, ready except for the three facts only you may hand over.
#
# Copy this to `cem.env` beside install.sh and fill the three blanks. install.sh merges it into .env on the
# first run, so a bundle built with INCLUDE_CEM=1 (which carries the driver jar and this file) installs a kit
# that reaches the cluster with nothing left to edit.
#
#   cp cem.env.example cem.env && chmod 600 cem.env && nano cem.env
#
# WHAT THIS FILE BECOMES IS A SECRET once you fill it: the account and its password in clear, like the
# platform's own spark.env. It is gitignored, and a bundle built with it inside must be handled like a
# password file — not on a shared drive, not attached to a ticket.

# ── already correct, from the platform's own gateway ──────────────────────────────────────────────────────────
# The driver class is the one INSIDE the Yacht jar. It is not what a search engine suggests, and a wrong class
# fails late — at the first connection, as "Class ... is not found".
CEM_JDBC_DRIVER=com.huawei.ryoma.yacht.client.YachtDriver
CEM_JDBC_JARS=/app/driver-jars/yacht-jdbc-25.70.278.jar

# ── yours to fill ─────────────────────────────────────────────────────────────────────────────────────────────
# The shape the platform uses, with its host and port left to you:
#   jdbc:yacht://<host>:<port>/datacube_dc_run-SPARKSQL?timeout=3600
CEM_JDBC_URL=
# Passed as JDBC properties, never inside the URL — several drivers ignore them there.
CEM_JDBC_USER=
CEM_JDBC_PASSWORD=

# The schema SQL Lab opens on by default when you query the CEM live (yacht://cem). The kit guesses it from
# the catalog in the URL, and that guess is wrong when the two differ: a catalog named
# `datacube_dc_run-SPARKSQL` holds the schema `dc_run`. Say it plainly here.
CEM_SCHEMA=dc_run

# ── Kerberos, if the cluster asks for a ticket ────────────────────────────────────────────────────────────────
# The platform runs its pull with Kerberos OFF. Set 1 here, put krb5.conf and the keytab in ./krb5/, and
# cem_to_mart.py will kinit before the JVM opens the connection.
CEM_KERBEROS=0
CEM_KRB_PRINCIPAL=
CEM_KRB_KEYTAB=/run/krb5/user.keytab
