# Secrets. .env holds this kit's own passwords, cem.env the customer's CEM account.
.env
cem.env
# …and any other environment file, key, certificate, keystore or keytab dropped beside them. The examples are kept.
.env.*
*.env
!.env.example
!cem.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
*.keystore
*.keytab
id_rsa*
id_ed25519*
*.secret
secrets/
credentials*.json
service-account*.json
.npmrc
.pypirc
.netrc

# Local working notes and assistant settings: not part of the kit.
SharpSight_BI_Studio_Spec_Updated.md
.claude/
*.log

# The customer's JDBC driver, and anything else dropped in to be mounted.
driver-jars/*.jar
krb5/*
!krb5/README.txt

# What the kit produces: bundles, dashboard exports, mart archives.
dist/
# …except the built panel of the Superset extension: it is what the bundle is made of, and the kit has no Node
!superset-extension/frontend/dist/
superset-extension/frontend/node_modules/
exports/*
!exports/.keep
*.tgz
*.tar.gz
*.tar.gz.sha256

# Python leftovers, when the engine's tests are run from a checkout.
__pycache__/
.pytest_cache/
